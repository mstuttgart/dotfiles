#!/bin/bash

# =============================================================================
# DOTFILES BOOTSTRAP SCRIPT
# =============================================================================
# 
# Description: Interactive bootstrap script for setting up a development
#              environment with dotfiles managed by yadm (Yet Another Dotfiles Manager)
#
# Author:      mstuttgart
# Repository:  https://github.com/mstuttgart/dotfiles
# License:     MIT
#
# This script provides an interactive menu to install and configure:
# - System packages and development tools
# - Neovim with dependencies
# - ZSH with zplug plugin manager
# - Docker and containerization tools
# - Nerd Fonts for terminal use
# - i3 Window Manager and related tools
#
# Usage:
#   ./bootstrap
#   
# Requirements:
#   - Ubuntu/Debian-based Linux distribution
#   - Internet connection
#   - sudo privileges
#
# Log files are created in /tmp/bootstrap-YYYYMMDD-HHMMSS.log
#
# =============================================================================

# Exit on error, undefined variables, and pipe failures
set -euo pipefail

# =============================================================================
# CONFIGURATION VARIABLES
# =============================================================================

# Variables for dotfiles repository
readonly GIT_USER="mstuttgart"
readonly GIT_REPO="dotfiles"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LOG_FILE="/tmp/bootstrap-$(date +%Y%m%d-%H%M%S).log"

# =============================================================================
# COLOR CONSTANTS FOR OUTPUT FORMATTING
# =============================================================================

# Colors for logging and user interface
readonly RED='\e[31m'
readonly YELLOW='\e[33m'
readonly GREEN='\e[32m'
readonly BOLDBLUE="\e[1;34m"
readonly BOLDGREEN="\e[1;32m"
readonly ENDCOLOR="\e[0m"

# =============================================================================
# LOGGING AND OUTPUT FUNCTIONS
# =============================================================================

# Log messages to file with timestamp
# Args: $1 - message to log
log_to_file() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

# Print a blank line
echo_nl() {
  echo ""
}

# Print informational message in blue
# Args: $1 - message to display
echo_print() {
  local message="$1"
  echo -e "${BOLDBLUE}=> $message ${ENDCOLOR}"
  log_to_file "INFO: $message"
}

# Print info message in green
# Args: $1 - message to display
echo_info() {
  local message="$1"
  echo -e "${BOLDGREEN}[info] $message ${ENDCOLOR}"
  log_to_file "INFO: $message"
}

# Print success message in green with checkmark
# Args: $1 - message to display
echo_ok() {
  local message="$1"
  echo -e "${GREEN}[ok] $message ✔${ENDCOLOR}"
  log_to_file "SUCCESS: $message"
}

# Print warning message in yellow
# Args: $1 - message to display
echo_warning() {
  local message="$1"
  echo -e "${YELLOW}[alert] $message ${ENDCOLOR}"
  log_to_file "WARNING: $message"
}

# Print error message in red
# Args: $1 - message to display
echo_error() {
  local message="$1"
  echo -e "${RED}[error] ✖ $message ✖ ${ENDCOLOR}"
  log_to_file "ERROR: $message"
}

# =============================================================================
# UTILITY FUNCTIONS
# =============================================================================

# Check return code and display appropriate message
# Args: $1 - exit code to check
#       $2 - operation description
check_return_code() {
  local exit_code="$1"
  local message="$2"
  
  if [ "$exit_code" -eq 0 ]; then
    echo_ok "$message"
  else
    echo_error "$message"
    exit 1
  fi
  echo_nl
}

# Check if a command exists in the system PATH
# Args: $1 - command name to check
# Returns: 0 if command exists, 1 if not
command_exists() {
  command -v "$1" >/dev/null 2>&1
}

# Verify the script is running on a supported operating system
# Supports Ubuntu and Debian-based distributions
check_os() {
  if [[ ! -f /etc/os-release ]]; then
    echo_error "Unsupported operating system"
    exit 1
  fi
  
  source /etc/os-release
  if [[ "$ID" != "ubuntu" ]] && [[ "$ID_LIKE" != *"ubuntu"* ]] && [[ "$ID_LIKE" != *"debian"* ]]; then
    echo_warning "This script is designed for Ubuntu/Debian. Proceed with caution."
  fi
}

# Generic package installation function for multiple package managers
# Args: $1 - package manager (apt, flatpak)
#       $@ - list of packages to install
install_packages() {
  local package_manager="$1"
  shift
  local packages=("$@")
  
  for package in "${packages[@]}"; do
    echo_info "-----------------------------------------------"
    echo_print "Installing $package"
    
    case "$package_manager" in
      "apt")
        sudo apt install -y "$package"
        ;;
      "flatpak")
        flatpak install -y flathub "$package"
        ;;
      *)
        echo_error "Unsupported package manager: $package_manager"
        return 1
        ;;
    esac
    
    check_return_code $? "$package"
  done
}

# =============================================================================
# USER INTERFACE FUNCTIONS
# =============================================================================

# Display the bootstrap script header with ASCII art
print_header() {
  clear
  echo -e "${BOLDBLUE}

██████╗  ██████╗ ████████╗███████╗██╗██╗     ███████╗███████╗
██╔══██╗██╔═══██╗╚══██╔══╝██╔════╝██║██║     ██╔════╝██╔════╝
██║  ██║██║   ██║   ██║   █████╗  ██║██║     █████╗  ███████╗
██║  ██║██║   ██║   ██║   ██╔══╝  ██║██║     ██╔══╝  ╚════██║
██████╔╝╚██████╔╝   ██║   ██║     ██║███████╗███████╗███████║
╚═════╝  ╚═════╝    ╚═╝   ╚═╝     ╚═╝╚══════╝╚══════╝╚══════╝

  ${YELLOW}BOOTSTRAP SCRIPT${BOLDGREEN}

" >&1
  echo_info "Log file: $LOG_FILE"
  echo_nl
}

# Display completion message and log file location
print_footer() {
  echo -e "${BOLDGREEN}
  Bootstrap of dotfiles completed!${YELLOW}
  Log out${BOLDBLUE} and${YELLOW} login${BOLDBLUE} to apply changes!${ENDCOLOR}
  
  Check the log file for details: $LOG_FILE
" >&1
}

# =============================================================================
# SYSTEM UPDATE AND MAINTENANCE FUNCTIONS
# =============================================================================

# Update system packages and remove unnecessary packages
# Performs: apt update, apt upgrade, apt autoremove
update_distro() {
  echo_print "Updating system packages"
  
  sudo apt update || {
    echo_error "Failed to update package list"
    return 1
  }
  
  sudo apt upgrade -y || {
    echo_error "Failed to upgrade packages"
    return 1
  }
  
  sudo apt autoremove -y || {
    echo_warning "Failed to autoremove packages"
  }
  
  echo_ok "System updated successfully"
}

# Update yadm repository origin URL to use SSH
# Requires: yadm to be installed
update_yadm_repo() {
  echo_print "Updating the yadm repo origin URL"
  
  if command_exists yadm; then
    yadm remote set-url origin "git@github.com:${GIT_USER}/${GIT_REPO}.git" || {
      echo_error "Failed to set yadm remote URL"
      return 1
    }
    echo_ok "yadm origin set successfully"
  else
    echo_error "yadm is not installed"
    return 1
  fi
}

# =============================================================================
# DEVELOPMENT TOOLS INSTALLATION FUNCTIONS
# =============================================================================

# Install Docker Community Edition with all plugins
# Includes: docker-ce, docker-ce-cli, containerd.io, buildx, compose
# Adds user to docker group for non-sudo usage
install_docker() {
  echo_print "Installing Docker"

  if command_exists docker; then
    echo_warning "Docker is already installed"
    return 0
  fi

  # Install prerequisites
  sudo apt install -y ca-certificates curl || {
    echo_error "Failed to install prerequisites"
    return 1
  }

  # Add Docker's official GPG key
  sudo install -m 0755 -d /etc/apt/keyrings || {
    echo_error "Failed to create keyrings directory"
    return 1
  }
  
  sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc || {
    echo_error "Failed to download Docker GPG key"
    return 1
  }
  
  sudo chmod a+r /etc/apt/keyrings/docker.asc || {
    echo_error "Failed to set permissions on Docker GPG key"
    return 1
  }

  # Add the repository to Apt sources
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu \
      $(. /etc/os-release && echo "$UBUNTU_CODENAME") stable" |
    sudo tee /etc/apt/sources.list.d/docker.list >/dev/null || {
    echo_error "Failed to add Docker repository"
    return 1
  }

  # Update package list and install Docker
  sudo apt-get update || {
    echo_error "Failed to update package list"
    return 1
  }
  
  sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin || {
    echo_error "Failed to install Docker"
    return 1
  }

  # Add user to docker group
  sudo usermod -aG docker "$USER" || {
    echo_warning "Failed to add user to docker group"
  }

  # Enable and start Docker service
  sudo systemctl enable docker || {
    echo_warning "Failed to enable Docker service"
  }
  
  sudo systemctl start docker || {
    echo_warning "Failed to start Docker service"
  }

  echo_ok "Docker installed successfully. Please reboot to use it without sudo"
}

# Install Neovim from official AppImage and required dependencies
# Downloads: Latest Neovim AppImage to /usr/bin/nvim
# Dependencies: ripgrep, python3-pip, gcc, git, python3-dev, ncurses-term, 
#               fd-find, fzf, xclip
install_nvim() {
  echo_print "Installing Neovim"
  
  local nvim_version="v0.12.5"
  local nvim_url="https://github.com/neovim/neovim/releases/download/${nvim_version}/nvim.appimage"
  
  # Check if nvim is already installed
  if command_exists nvim; then
    echo_warning "Neovim is already installed"
    nvim --version | head -1
    return 0
  fi

  # Download and install Neovim
  echo_info "Downloading Neovim ${nvim_version}"
  wget -O nvim.appimage "$nvim_url" || {
    echo_error "Failed to download Neovim"
    return 1
  }
  
  chmod +x nvim.appimage || {
    echo_error "Failed to make Neovim executable"
    return 1
  }
  
  sudo mv nvim.appimage /usr/bin/nvim || {
    echo_error "Failed to move Neovim to /usr/bin"
    return 1
  }

  # Install Neovim dependencies
  local nvim_packages=(
    "ripgrep"
    "python3-pip"
    "gcc"
    "git"
    "python3-dev"
    "ncurses-term"
    "fd-find"
    "fzf"
    "xclip"
  )

  echo_print "Installing Neovim dependencies"
  install_packages "apt" "${nvim_packages[@]}"

  echo_ok "Neovim installed successfully"
}


# Install and configure ZSH shell with zplug plugin manager
# Installs: zsh, curl
# Configures: zplug plugin manager, changes default shell to zsh
install_zsh() {
  echo_print "Installing and configuring ZSH"

  local zsh_packages=(
    "zsh"
    "curl"
  )

  install_packages "apt" "${zsh_packages[@]}"

  # Install zplug
  if [[ ! -d "$HOME/.zplug" ]]; then
    echo_info "Installing zplug"
    curl -sL --proto-redir -all,https https://raw.githubusercontent.com/zplug/installer/master/installer.zsh | zsh || {
      echo_error "Failed to install zplug"
      return 1
    }
    echo_ok "zplug installed successfully"
  else
    echo_warning "zplug is already installed"
  fi

  # Change default shell to zsh
  if [[ "$(basename "$SHELL")" != "zsh" ]]; then
    echo_info "Changing default shell to zsh"
    chsh -s /bin/zsh || {
      echo_warning "Failed to change shell to zsh. You may need to do this manually."
    }
  else
    echo_info "zsh is already the default shell"
  fi

  echo_ok "ZSH setup completed"
}

# Install comprehensive system packages for development and productivity
# Categories:
#   - CLI tools: bat, btop, eza, net-tools, p7zip, pass, pwgen, unrar, wget
#   - Programming: alacritty, cmake, gcc, git, make, build-essential, dev libraries
#   - Python: python3-dev, python3-pip, python3-venv, pipx
#   - Tools: tig, tmux
#   - Desktop apps: filezilla, firefox, flameshot, foliate, font-manager, 
#                   gimp, gpick, meld, poedit, spotify-client, transmission-gtk
# Also installs: tmux plugin manager, asdf version manager, Rust
install_system_packages() {
  echo_print "Installing system packages"

  local apt_packages=(
    # CLI apps
    "bat"
    "btop"
    "eza"
    "net-tools"
    "p7zip"
    "pass"
    "pwgen"
    "unrar"
    "wget"
    "ca-certificates"

    # Programming tools and libraries
    "alacritty"
    "cmake"
    "gcc"
    "git"
    "make"
    "build-essential"
    "libssl-dev"
    "zlib1g-dev"
    "libbz2-dev"
    "libreadline-dev"
    "libsqlite3-dev"
    "curl"
    "libncursesw5-dev"
    "xz-utils"
    "tk-dev"
    "libxml2-dev"
    "libxmlsec1-dev"
    "libffi-dev"
    "liblzma-dev"
    "python3-dev"
    "python3-pip"
    "python3-venv"
    "pipx"
    "tig"

    # Desktop apps
    "filezilla"
    "firefox"
    "flameshot"
    "foliate"
    "font-manager"
    "gimp"
    "gpick"
    "meld"
    "poedit"
    "transmission-gtk"
  )

  install_packages "apt" "${apt_packages[@]}"

  # Install Flatpak packages
  if command_exists flatpak; then
    local flatpak_packages=(
      "com.github.IsmaelMartinez.teams_for_linux"
      "com.getpostman.Postman"
      "gearlever.flatpak"
    )
    
    echo_print "Installing Flatpak packages"
    install_packages "flatpak" "${flatpak_packages[@]}"
  else
    echo_warning "Flatpak not available, skipping Flatpak packages"
  fi

  # Install asdf version manager
  if [[ ! -d "$HOME/.asdf" ]]; then
    echo_info "Installing asdf version manager"
    git clone https://github.com/asdf-vm/asdf.git "$HOME/.asdf" --branch v0.13.1 || {
      echo_warning "Failed to install asdf"
    }
  fi

  # Install asdf plugins (only if asdf was successfully installed)
  if [[ -d "$HOME/.asdf" ]]; then
    echo_info "Installing asdf plugins"
    "$HOME/.asdf/bin/asdf" plugin-add python 2>/dev/null || echo_warning "Python plugin already exists or failed to install"
    "$HOME/.asdf/bin/asdf" plugin-add nodejs 2>/dev/null || echo_warning "Node.js plugin already exists or failed to install"
  fi

  # Install Rust
  if ! command_exists rustc; then
    echo_info "Installing Rust"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y || {
      echo_warning "Failed to install Rust"
    }
  else
    echo_warning "Rust is already installed"
  fi

  echo_ok "System packages installed successfully"
}

# Install JetBrainsMono and SourceCodePro Nerd Fonts
# Downloads from: https://github.com/ryanoasis/nerd-fonts
# Installs to: ~/.local/share/fonts
# Updates font cache after installation
install_fonts() {
  echo_print "Installing Nerd Fonts"

  local temp_dir="/tmp/nerd-fonts"
  local fonts_dir="$HOME/.local/share/fonts"

  # Create fonts directory if it doesn't exist
  mkdir -p "$fonts_dir"

  # Clone or update Nerd Fonts repository
  if [[ ! -d "$temp_dir" ]]; then
    echo_info "Cloning Nerd Fonts repository"
    git clone --depth 1 https://github.com/ryanoasis/nerd-fonts.git "$temp_dir" || {
      echo_error "Failed to clone Nerd Fonts repository"
      return 1
    }
  else
    echo_info "Updating Nerd Fonts repository"
    cd "$temp_dir" && git pull || {
      echo_warning "Failed to update Nerd Fonts repository"
    }
  fi

  cd "$temp_dir" || {
    echo_error "Failed to change to Nerd Fonts directory"
    return 1
  }

  # Install specific fonts
  echo_info "Installing JetBrainsMono Nerd Font"
  ./install.sh -q JetBrainsMono || {
    echo_warning "Failed to install JetBrainsMono font"
  }

  echo_info "Installing SourceCodePro Nerd Font"
  ./install.sh -q SourceCodePro || {
    echo_warning "Failed to install SourceCodePro font"
  }

  # Update font cache
  echo_info "Updating font cache"
  fc-cache -f -v >/dev/null 2>&1 || {
    echo_warning "Failed to update font cache"
  }

  # Clean up
  cd "$HOME" || exit 1

  echo_ok "Fonts installed successfully"
}

# =============================================================================
# WINDOW MANAGER INSTALLATION FUNCTIONS
# =============================================================================

# Install i3 Window Manager and related tools
# Packages: i3-wm, polybar, rofi, dunst, nitrogen, picom, thunar, etc.
install_i3wm() {
  echo_print "Installing i3 Window Manager"

  local i3wm_packages=(
    "acpi"
    "arandr"
    "autorandr"
    "dmenu"
    "dunst"
    "galculator"
    "gsimplecal"
    "i3-wm"
    "i3lock"
    "jq"
    "mpv"
    "lxappearance"
    "neofetch"
    "nitrogen"
    "numlockx"
    "picom"
    "playerctl"
    "polybar"
    "rofi"
    "sysstat"
    "thunar"
    "thunar-archive-plugin"
    "thunar-volman"
    "tumbler"
    "unzip"
    "viewnior"
    "xarchiver"
    "xbindkeys"
    "xdg-user-dirs-gtk"
    "xed"
    "zip"
  )

  install_packages "apt" "${i3wm_packages[@]}"
  echo_ok "i3 Window Manager installed successfully"
}

# =============================================================================
# CLEANUP AND MAINTENANCE FUNCTIONS
# =============================================================================

# Clean up temporary files and perform system cleanup
# Removes: /tmp/nerd-fonts directory
# Performs: apt autoremove, apt autoclean
cleanup() {
  echo_info "Cleaning up temporary files"
  rm -rf /tmp/nerd-fonts 2>/dev/null || true
  sudo apt autoremove -y >/dev/null 2>&1 || true
  sudo apt autoclean >/dev/null 2>&1 || true
}

# Signal handler for cleanup on script exit
trap cleanup EXIT

# =============================================================================
# MAIN EXECUTION FUNCTION
# =============================================================================

# Main function that orchestrates the entire bootstrap process
# Provides interactive menu for selecting installation options
main() {
  # Check OS compatibility
  check_os
  
  # Because Git submodule commands cannot operate without a work tree, they must
  # be run from within $HOME (assuming this is the root of your dotfiles)
  cd "$HOME" || {
    echo_error "Failed to change to home directory"
    exit 1
  }

  print_header

  local PS3="Select action please: "
  local items=(
    "Update System" 
    "Install System Packages" 
    "Install Neovim" 
    "Install Fonts" 
    "Install ZSH" 
    "Install Docker"
    "Install i3 Window Manager"
    "Install All"
  )

  while true; do
    select item in "${items[@]}" Quit; do
      case $REPLY in
        1)
          echo_print "Selected: $item"
          update_distro
          echo_nl
          break
          ;;
        2)
          echo_print "Selected: $item"
          install_system_packages
          echo_nl
          break
          ;;
        3)
          echo_print "Selected: $item"
          install_nvim
          echo_nl
          break
          ;;
        4)
          echo_print "Selected: $item"
          install_fonts
          echo_nl
          break
          ;;
        5)
          echo_print "Selected: $item"
          install_zsh
          echo_nl
          break
          ;;
        6)
          echo_print "Selected: $item"
          install_docker
          echo_nl
          break
          ;;
        7)
          echo_print "Selected: $item"
          install_i3wm
          echo_nl
          break
          ;;
        8)
          echo_print "Selected: Install All"
          update_distro
          install_system_packages
          install_fonts
          install_zsh
          install_docker
          echo_nl
          break
          ;;
        $((${#items[@]} + 1)))
          echo_print "Exiting..."
          print_footer
          break 2
          ;;
        *)
          echo_error "Invalid choice: $REPLY"
          break
          ;;
      esac
    done
  done
}

# =============================================================================
# SCRIPT ENTRY POINT
# =============================================================================

# Run main function with all arguments passed to script
main "$@"
